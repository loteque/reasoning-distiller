{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-distiller.local/schemas/context-pack-result.schema.json",
  "title": "Reasoning Distiller Context Pack Result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "request_id", "status", "pack"],
      "properties": {
        "contract": {"const": "reasoning-distiller-context-pack-result/1"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"const": "success"},
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "pack_identity_sha256"],
          "properties": {
            "contract": {"const": "reasoning-distiller-context-pack/1"},
            "pack_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "request_id", "status", "failure"],
      "properties": {
        "contract": {"const": "reasoning-distiller-context-pack-result/1"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"const": "failure"},
        "failure": {"$ref": "https://reasoning-distiller.local/schemas/context-pack-failure.schema.json"}
      }
    }
  ]
}
