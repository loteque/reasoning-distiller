{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loteque/reasoning-distiller/blob/main/schemas/installation-record.schema.json",
  "title": "Reasoning Distiller installation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "package_contract",
    "installer",
    "version",
    "source_commit",
    "content_identity",
    "transport_sha256",
    "managed_root",
    "installed_at",
    "compatibility"
  ],
  "properties": {
    "contract": {"const": "reasoning-distiller-installation/1"},
    "package_contract": {"const": "reasoning-distiller-install-package/1"},
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "entrypoint", "runtime"],
      "properties": {
        "contract": {"const": "reasoning-distiller-installer/1"},
        "entrypoint": {"const": "rd_install.py"},
        "runtime": {"const": "python3"}
      }
    },
    "version": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "content_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "transport_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "managed_root": {"type": "string", "minLength": 1},
    "installed_at": {"type": "string", "format": "date-time"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_knowledge_package", "rgp", "backends"],
      "properties": {
        "project_knowledge_package": {"$ref": "#/$defs/nonEmptyStringArray"},
        "rgp": {"$ref": "#/$defs/nonEmptyStringArray"},
        "backends": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/nonEmptyStringArray"}
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    },
    "source_repository": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "update_locator": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
