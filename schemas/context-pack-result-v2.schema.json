{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-distiller.local/schemas/context-pack-result-v2.schema.json",
  "title": "Reasoning Distiller Context Pack Result v2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["contract", "request_id", "status", "pack"],
      "properties": {
        "contract": {"const": "reasoning-distiller-context-pack-result/2"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"const": "success"},
        "pack": {
          "type": "object", "additionalProperties": false, "required": ["contract", "pack_identity_sha256"],
          "properties": {"contract": {"const": "reasoning-distiller-context-pack/2"}, "pack_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}
        }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["contract", "request_id", "status", "failure"],
      "properties": {
        "contract": {"const": "reasoning-distiller-context-pack-result/2"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"const": "failure"},
        "failure": {"$ref": "https://reasoning-distiller.local/schemas/context-pack-failure.schema.json"}
      }
    }
  ]
}
