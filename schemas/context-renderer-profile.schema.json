{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-distiller.local/schemas/context-renderer-profile.schema.json",
  "title": "Reasoning Distiller Context Renderer Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile_id",
    "profile_version",
    "supported_pack_contracts",
    "pack_profile",
    "renderer_component",
    "framing",
    "limits"
  ],
  "properties": {
    "contract": {"const": "reasoning-distiller-context-renderer-profile/1"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "supported_pack_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "reasoning-distiller-context-pack/1",
          "reasoning-distiller-context-pack/2"
        ]
      }
    },
    "pack_profile": {"$ref": "#/$defs/profileIdentity"},
    "renderer_component": {"$ref": "#/$defs/rendererComponent"},
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "serializer",
        "text_encoding",
        "item_encoding",
        "plane_order"
      ],
      "properties": {
        "contract": {"const": "reasoning-distiller-context-renderer-framing/1"},
        "serializer": {"const": "jcs/1"},
        "text_encoding": {"const": "utf-8"},
        "item_encoding": {"const": "base64"},
        "plane_order": {
          "const": ["control", "knowledge", "operational_evidence"]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_activation_bytes"],
      "properties": {
        "max_activation_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "raw_sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      }
    },
    "rendererComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contract", "immutable_identity", "raw_sha256"],
      "properties": {
        "role": {"const": "renderer"},
        "contract": {"const": "reasoning-distiller-context-renderer/1"},
        "immutable_identity": {"type": "string", "pattern": "^git-blob:[0-9a-f]{40}$"},
        "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      }
    }
  }
}
