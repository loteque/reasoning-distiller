{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-distiller.local/schemas/context-pack-v2.schema.json",
  "title": "Reasoning Distiller Context Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "profile", "request", "source_registry", "control_plane", "knowledge_plane", "operational_evidence_plane", "inclusion_ledger", "identity", "toolchain"],
  "properties": {
    "contract": {"const": "reasoning-distiller-context-pack/2"},
    "profile": {"$ref": "#/$defs/profileIdentity"},
    "request": {"$ref": "#/$defs/requestIdentity"},
    "eligibility": {
      "type": "object", "additionalProperties": false, "required": ["consumer_contract", "consumer_id", "policy_evidence_snapshot_id", "decision"],
      "properties": {"consumer_contract": {"type": "string", "minLength": 1}, "consumer_id": {"type": "string", "minLength": 1}, "policy_evidence_snapshot_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["eligible", "ineligible"]}}
    },
    "source_registry": {"type": "array", "minItems": 1, "items": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json"}},
    "control_plane": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/opaqueItem"}}}},
    "knowledge_plane": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledgeItem"}}}},
    "operational_evidence_plane": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/operationalItem"}}}},
    "inclusion_ledger": {"type": "array", "items": {"$ref": "#/$defs/ledgerEntry"}},
    "identity": {"$ref": "#/$defs/packIdentity"},
    "toolchain": {"$ref": "#/$defs/toolchain"}
  },
  "$defs": {
    "profileIdentity": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "raw_sha256"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "profile_version": {"type": "string", "minLength": 1}, "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}},
    "requestIdentity": {"type": "object", "additionalProperties": false, "required": ["request_id", "raw_sha256"], "properties": {"request_id": {"type": "string", "minLength": 1}, "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["encoding", "data", "raw_sha256"], "properties": {"encoding": {"const": "base64"}, "data": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}, "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}, "media_type": {"type": "string", "minLength": 1}}},
    "opaqueItem": {"type": "object", "additionalProperties": false, "required": ["source_ref", "payload"], "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/controlSnapshotRef"}, "payload": {"$ref": "#/$defs/payload"}}},
    "operationalItem": {
      "type": "object", "additionalProperties": false, "required": ["source_ref", "validation_status", "payload"],
      "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/operationalEvidenceSnapshotRef"}, "validation_status": {"enum": ["carried_unvalidated", "shape_and_digest_validated", "accepted_validation_result"]}, "validation_result": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/validationResultIdentity"}, "payload": {"$ref": "#/$defs/payload"}},
      "allOf": [{"if": {"properties": {"validation_status": {"const": "accepted_validation_result"}}, "required": ["validation_status"]}, "then": {"required": ["validation_result"]}, "else": {"not": {"required": ["validation_result"]}}}]
    },
    "knowledgeItem": {
      "type": "object", "additionalProperties": false, "required": ["canonical_snapshot_ref", "semantic", "serializer", "pems"],
      "properties": {
        "canonical_snapshot_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/canonicalSnapshotRef"},
        "semantic": {"const": "pems/2"},
        "serializer": {"const": "jcs/1"},
        "pems": {"$ref": "urn:reasoning-distiller:schema-resource:pems-v2:git-blob:cd7683d704e8aef2842a0c1b25b453fb1dbc8030"},
        "cove_payload": {
          "type": "object", "additionalProperties": false, "required": ["cove_semantic", "pems_semantic", "serializer", "encoding", "data", "raw_sha256"],
          "properties": {"cove_semantic": {"const": "cove/1"}, "pems_semantic": {"const": "pems/2"}, "serializer": {"const": "jcs/1"}, "encoding": {"const": "base64"}, "data": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}, "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}
        }
      }
    },
    "cause": {"type": "object", "additionalProperties": false, "required": ["kind", "cause_id"], "properties": {"kind": {"enum": ["profile_slot", "request_selector", "pems_closure"]}, "cause_id": {"type": "string", "minLength": 1}}},
    "packIdentity": {
      "type": "object", "additionalProperties": false, "required": ["profile_sha256", "request_sha256", "canonical_state_binding_sha256s", "selected_pems_sha256", "manifest_sha256", "payload_set_sha256", "pack_identity_sha256"],
      "properties": {
        "profile_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "canonical_state_binding_sha256s": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}},
        "selected_pems_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "cove_payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "payload_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "pack_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      }
    },
    "toolchainComponent": {"type": "object", "additionalProperties": false, "required": ["role", "contract", "immutable_identity", "raw_sha256"], "properties": {"role": {"enum": ["pems_schema", "pems_validator", "closure_descriptor", "cove_adapter", "jcs_serializer", "pack_builder"]}, "contract": {"type": "string", "minLength": 1}, "immutable_identity": {"type": "string", "minLength": 1}, "raw_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["components"], "properties": {"components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/toolchainComponent"}}}},
    "controlLedgerSubject": {"type": "object", "additionalProperties": false, "required": ["source_ref"], "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/controlSnapshotRef"}, "semantic_id": {"type": "string", "minLength": 1}}},
    "pemsRef": {"type": "object", "additionalProperties": false, "required": ["namespace", "id"], "properties": {"namespace": {"enum": ["record", "relation"]}, "id": {"type": "string", "minLength": 1}}},
    "knowledgeSnapshotLedgerSubject": {"type": "object", "additionalProperties": false, "required": ["source_ref"], "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/canonicalSnapshotRef"}}},
    "knowledgePemsLedgerSubject": {"type": "object", "additionalProperties": false, "required": ["source_ref", "pems_ref"], "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/canonicalSnapshotRef"}, "pems_ref": {"$ref": "#/$defs/pemsRef"}}},
    "knowledgeLedgerSubject": {"oneOf": [{"$ref": "#/$defs/knowledgeSnapshotLedgerSubject"}, {"$ref": "#/$defs/knowledgePemsLedgerSubject"}]},
    "operationalLedgerSubject": {"type": "object", "additionalProperties": false, "required": ["source_ref"], "properties": {"source_ref": {"$ref": "https://reasoning-distiller.local/schemas/context-source-binding.schema.json#/$defs/operationalEvidenceSnapshotRef"}, "semantic_id": {"type": "string", "minLength": 1}}},
    "controlLedgerEntry": {"type": "object", "additionalProperties": false, "required": ["plane", "subject", "causes"], "properties": {"plane": {"const": "control"}, "subject": {"$ref": "#/$defs/controlLedgerSubject"}, "causes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cause"}}}},
    "knowledgeLedgerEntry": {"type": "object", "additionalProperties": false, "required": ["plane", "subject", "causes"], "properties": {"plane": {"const": "knowledge"}, "subject": {"$ref": "#/$defs/knowledgeLedgerSubject"}, "causes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cause"}}}},
    "operationalLedgerEntry": {"type": "object", "additionalProperties": false, "required": ["plane", "subject", "causes"], "properties": {"plane": {"const": "operational_evidence"}, "subject": {"$ref": "#/$defs/operationalLedgerSubject"}, "causes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cause"}}}},
    "ledgerEntry": {"oneOf": [{"$ref": "#/$defs/controlLedgerEntry"}, {"$ref": "#/$defs/knowledgeLedgerEntry"}, {"$ref": "#/$defs/operationalLedgerEntry"}]}
  }
}
