{
  "binding_contract": "reasoning-distiller-renderer-execution-binding/1",
  "bundle_roots": [
    "member:render",
    "member:decode",
    "member:resolve_bundle",
    "member:describe_bundle",
    "member:derive_execution_binding",
    "member:compare_execution_binding"
