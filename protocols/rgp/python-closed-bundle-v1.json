  "contract": "reasoning-distiller-python-closed-bundle/1",
  "dependency_closure": [
    "Every repository-owned callable and behavior-bearing data object used by a root or member MUST be explicitly registered as a member; an open-ended reachability walk is not the contract.",
    "Every executable global reference of a registered repository Python function MUST resolve to another registered member, one allowlisted runtime primitive, or one frozen non-behavioral metadata name.",
    "An unregistered repository callable/data dependency, mutable repository-local module dependency, dynamic import/helper discovery, or eval/exec behavior source fails closed.",
    "Mutable list/dict/set defaults, persistent closure cells, or behavior constants are unsupported; P9R2 must refactor them to frozen representable values.",
    "Positional defaults, keyword defaults, and persistent closure cells are normalized; unsupported or mutable values fail closed.",
    "Descriptor construction may use only the captured bundle and exact runtime information, never filesystem/source/Git/install/network/branch/cache/model/search/project state.",
    "Duplicate/unsorted member or dependency collections, missing declared targets, and undeclared behavior fail closed.",
    "The member registry, resolver, descriptor, binding derivation, and binding comparison are themselves behavior-bearing and must be registered in the same bundle."
  ],
  "descriptor": {
    "closure_order": "co_freevars order",
    "constant_inclusion": "only constants referenced by executable instructions/defaults/closures/registered immutable members are included; unreferenced co_consts are excluded",
    "debug_exclusions": [
      "co_filename",
      "co_firstlineno",
      "co_linetable",
      "instruction byte offsets except transient ordinal mapping",
      "instruction positions/source lines",
      "checkout/source path",
      "repository identity",
      "comments",
      "unreferenced docstrings"
    ],
    "dependency_order": "UTF-8 byte order by dependency name then target; duplicates forbidden",
    "exception_fields": [
      "start ordinal",
      "end ordinal",
      "target ordinal",
      "depth",
      "lasti"
    ],
    "exception_source": "dis.Bytecode(code).exception_entries",
    "forbidden_serializations": [
      "marshal.dumps(code)",
      "repr(code/function)",
      "pickle/opaque host serialization"
    ],
    "function_code_fields": [
      "co_name",
      "co_qualname",
      "co_argcount",
      "co_posonlyargcount",
      "co_kwonlyargcount",
      "co_nlocals",
      "co_stacksize",
      "co_flags",
      "all co_varnames as local_names",
      "parameter_names from call-binding slots including varargs/varkw",
      "co_names as global_names",
      "co_freevars",
      "co_cellvars",
      "normalized instructions",
      "normalized exception table"
    ],
    "instruction_fields": [
      "opname",
      "operand_kind",
      "normalized operand"
    ],
    "instruction_normalization": [
      "dis.hasconst => normalized instruction.argval, never co_consts index",
      "dis.hasname => semantic name plus exact-ABI argrepr only for name-op semantic modifiers",
      "dis.haslocal => semantic local name, never co_varnames index",
      "dis.hasfree => semantic free/cell name, never numeric index",
      "comparison opcode => semantic comparison string",
      "dis.hasjrel/dis.hasjabs => normalized target instruction ordinal",
      "other argument-bearing opcode => semantic integer oparg under exact ABI",
      "argument-free opcode => JSON null"
    ],
    "instruction_source": "dis.get_instructions(code, show_caches=False, adaptive=False)",
    "kwdefault_order": "UTF-8 byte order by keyword name",
    "member_order": "UTF-8 byte order by member id; duplicates forbidden",
    "nested_code": "executable code constants recursively use the same code descriptor",
    "normalized_values": {
      "bool": "JSON boolean",
      "bytes": "RFC 4648 Base64 padded no whitespace",
      "code": "recursive code descriptor",
      "float64": "finite IEEE-754 binary64 big-endian 16 lowercase hex",
      "frozenset": "normalized items sorted by exact JCS bytes",
      "int": "canonical signed base-10 string",
      "none": "tag only",
      "str": "exact Unicode without surrogates",
      "tuple": "ordered recursively normalized items"
    },
    "parameter_names": "co_varnames call-binding prefix plus CO_VARARGS/CO_VARKEYWORDS slots"
  },
  "descriptor_contract": "reasoning-distiller-python-closed-bundle-descriptor/1",
  "gate": "P9R1",
