  "structural_rules": [
    {
      "rule_id": "pems2.derived_proposition.premise_relations",
      "trigger": {
        "scope": "record",
        "record_kind": "proposition",
        "path": "data.epistemic_role",
        "equals": "derived"
      },
      "rule": "include_transitively",
      "relation_match": {
        "kind": "derived_from",
        "from": "$trigger_record.id"
      },
      "multiplicity": "all_matching_relations",
      "on_zero_matches": "reject",
      "note": "Include every canonical derived_from relation whose from equals the included derived proposition ID. Ordinary relation rules then include every premise endpoint and referenced provenance. No other inverse-relation discovery is permitted."
    }
  ],
  "traversal": {
    "seed": "exact request-selected record_ids and relation_ids only",
    "visited_identity": "(namespace,id) where namespace is record or relation",
    "cycles": "terminate by visited identity; do not truncate valid cycles",
    "multiple_causes": "include an item once while preserving every deterministic inclusion cause in the outer packaging ledger",
    "missing_internal_target": "reject",
    "reverse_relation_discovery": "none_except_pems2.derived_proposition.premise_relations",
    "external_resolution": "forbidden_by_closure",
    "model_judgment": "forbidden",
    "limits": "projection limits are enforced by the later projection implementation; exceeding them rejects rather than truncates",
    "absent_or_null_field": "A field that is absent, or is null where the bound PEMS/2 schema permits null, contributes no reference and no closure edge."
  },
  "undefined_reference_policy": "reject",
  "undefined_reference_failure_code": "UNDEFINED_CLOSURE_RULE",
  "missing_target_failure_code": "SELECTED_SEMANTIC_ID_MISSING",
  "post_closure_validation": {
    "structural_schema_required": true,
    "semantic_validator_required": true,
    "mutation_permitted": false
  },
  "scope_exclusions": [
    "No source resolution is implemented.",
    "No PEMS projection engine is implemented.",
    "No profile eligibility semantics are added.",
    "No COVE behavior is added or changed.",
    "No persistence, rendering, production integration, canonical mutation, reconciliation, admission, authorization, or activation is performed.",
    "The P1c closure-descriptor identity fixture remains a P1c-only identity artifact and is not rewritten."
  ]
